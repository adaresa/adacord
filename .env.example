DISCORD_TOKEN=your-discord-bot-token

# Optional: set this for instant slash-command updates in one server.
DISCORD_GUILD_ID=

DEFAULT_VOLUME=50

PLAYER_IDLE_TIMEOUT=30
VOICE_CONNECT_TIMEOUT=30

# Optional: helps Lavalink play YouTube tracks from VPS/datacenter IPs when
# YouTube asks clients to sign in. Use a dedicated Google/YouTube account.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=
YOUTUBE_OAUTH_SKIP_INITIALIZATION=true

# Optional: enables the playback watchdog Compose profile. This mounts the
# Docker socket so the watchdog can restart the music stack after repeated
# Lavalink YouTube load failures. See README before enabling.
# COMPOSE_PROFILES=watchdog
